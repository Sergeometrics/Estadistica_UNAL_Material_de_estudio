### 11.7 Test de Independencia (Kernel)

```r
indep_test <- function(x, y, B=1000, bw_x=NULL, bw_y=NULL) {
  n <- length(x)
  if(is.null(bw_x)) bw_x <- bw.nrd0(x)
  if(is.null(bw_y)) bw_y <- bw.nrd0(y)
  Kx <- dnorm(outer(x, x, "-")/bw_x)/((n-1)*bw_x)
  Ky <- dnorm(outer(y, y, "-")/bw_y)/((n-1)*bw_y)
  diag(Kx) <- 0; diag(Ky) <- 0
  fx <- rowSums(Kx); fy <- rowSums(Ky)
  fxy <- rowSums(Kx*Ky)
  T_obs <- mean(log(fxy/pmax(fx*fy, 1e-10)))
  T_null <- numeric(B)
  for(b in 1:B){
    p <- sample.int(n)
    Ky_p <- Ky[,p]
    fy_b <- rowSums(Ky_p)
    fxy_b <- rowSums(Kx*Ky_p)
    T_null[b] <- mean(log(fxy_b/pmax(fx*fy_b, 1e-10)))
  }
  p_val <- mean(abs(T_null) >= abs(T_obs))
  return(list(stat=T_obs, p_value=p_val))
}
```

